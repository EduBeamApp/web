# Hashed build output never changes under the same name. The build manifest in /_nuxt/builds/
# is not hashed and keeps the default revalidation.
/_nuxt/*
  Cache-Control: public, max-age=31536000, immutable

/_nuxt/builds/*
  ! Cache-Control

# Not pages: the empty app shell and the data the pages load. Search engines index the pages.
/200
  X-Robots-Tag: noindex
/200.html
  X-Robots-Tag: noindex
/_payload.json
  X-Robots-Tag: noindex
/*/_payload.json
  X-Robots-Tag: noindex
/__nuxt_content/*
  X-Robots-Tag: noindex
/search/*
  X-Robots-Tag: noindex
